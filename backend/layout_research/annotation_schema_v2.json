{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/layout-research/annotation-schema-v2.json",
  "title": "REAL_LAYOUT_DEV_GOLD page annotation",
  "type": "object",
  "required": ["schema_version", "gold_type", "split", "doc_id", "page_number", "width", "height", "coordinate_origin", "slices", "status", "human_confirmed", "blocks", "table_regions", "rows", "columns", "cells", "relationships", "continuations"],
  "properties": {
    "schema_version": {"const": 2},
    "gold_type": {"const": "REAL_LAYOUT_DEV_GOLD"},
    "split": {"const": "DEV"},
    "doc_id": {"pattern": "^doc_[0-9]{3}$"},
    "page_number": {"type": "integer", "minimum": 1},
    "width": {"type": "number", "exclusiveMinimum": 0},
    "height": {"type": "number", "exclusiveMinimum": 0},
    "coordinate_origin": {"const": "top-left"},
    "slices": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
    "status": {"enum": ["NOT_STARTED", "IN_PROGRESS", "COMPLETED", "REVIEWED"]},
    "human_confirmed": {"type": "boolean"},
    "blocks": {"type": "array", "items": {"$ref": "#/$defs/block"}},
    "table_regions": {"type": "array", "items": {"$ref": "#/$defs/boxEntity"}},
    "rows": {"type": "array", "items": {"$ref": "#/$defs/boxEntity"}},
    "columns": {"type": "array", "items": {"$ref": "#/$defs/boxEntity"}},
    "cells": {"type": "array", "items": {"$ref": "#/$defs/cell"}},
    "relationships": {"type": "array", "items": {"$ref": "#/$defs/relationship"}},
    "continuations": {"type": "array", "items": {"$ref": "#/$defs/continuation"}},
    "audit": {"type": "object"}
  },
  "$defs": {
    "bbox": {"type": "array", "prefixItems": [{"type": "number"}, {"type": "number"}, {"type": "number"}, {"type": "number"}], "minItems": 4, "maxItems": 4},
    "block": {
      "type": "object",
      "required": ["block_id", "bbox", "block_type", "reading_order", "section_id", "page_number", "human_confirmed"],
      "properties": {
        "block_id": {"type": "string", "minLength": 1}, "bbox": {"$ref": "#/$defs/bbox"},
        "block_type": {"enum": ["HEADING", "PARAGRAPH", "LIST", "TABLE_CELL", "CAPTION", "OTHER"]},
        "reading_order": {"type": "integer", "minimum": 0}, "section_id": {"type": "string"},
        "table_region_id": {"type": "string"}, "row_id": {"type": "string"}, "column_id": {"type": "string"},
        "page_number": {"type": "integer", "minimum": 1}, "human_confirmed": {"type": "boolean"}
      }
    },
    "boxEntity": {
      "type": "object", "required": ["bbox", "page_number", "human_confirmed"],
      "properties": {"bbox": {"$ref": "#/$defs/bbox"}, "page_number": {"type": "integer"}, "human_confirmed": {"type": "boolean"}}
    },
    "cell": {
      "type": "object",
      "required": ["cell_id", "bbox", "page_number", "table_region_id", "row_id", "column_id", "human_confirmed"],
      "properties": {"cell_id": {"type": "string"}, "bbox": {"$ref": "#/$defs/bbox"}, "page_number": {"type": "integer"}, "table_region_id": {"type": "string"}, "row_id": {"type": "string"}, "column_id": {"type": "string"}, "human_confirmed": {"type": "boolean"}}
    },
    "relationship": {
      "type": "object",
      "required": ["relationship_id", "source_id", "target_id", "relationship_type", "page_number", "human_confirmed"],
      "properties": {
        "relationship_id": {"type": "string"}, "source_id": {"type": "string"}, "target_id": {"type": "string"},
        "relationship_type": {"enum": ["SECTION_CONTAINS", "TABLE_CONTAINS", "ROW_CONTAINS", "COLUMN_CONTAINS", "HEADER_APPLIES_TO", "CAPTION_DESCRIBES", "AMBIGUOUS"]},
        "page_number": {"type": "integer"}, "human_confirmed": {"type": "boolean"}
      }
    },
    "continuation": {
      "type": "object",
      "required": ["from_doc_id", "from_page_number", "from_table_region_id", "to_doc_id", "to_page_number", "to_table_region_id", "human_confirmed"],
      "properties": {"from_doc_id": {"type": "string"}, "from_page_number": {"type": "integer"}, "from_table_region_id": {"type": "string"}, "to_doc_id": {"type": "string"}, "to_page_number": {"type": "integer"}, "to_table_region_id": {"type": "string"}, "human_confirmed": {"type": "boolean"}}
    }
  }
}
